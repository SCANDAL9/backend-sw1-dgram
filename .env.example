# ==========================================
# dgram — Plantilla de Variables de Entorno
# ==========================================

# Base de Datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dgram

# Caché & Pub/Sub Redis
REDIS_URL=redis://localhost:6379
WS_HISTORY_LIMIT=50

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://localhost

# Modos de Ejecución
USE_NORMALIZED_READS=true
DEV_MODE=true

# Seguridad & Tokens JWT
JWT_SECRET_KEY=dgram-super-secret-jwt-key-for-auth
JWT_EXPIRATION_SECONDS=604800

# Google Cloud Vertex AI (Gemini 2.0 Flash / Vision OCR)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_MODEL_NAME=gemini-2.0-flash-001
